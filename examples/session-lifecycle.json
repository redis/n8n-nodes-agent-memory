      "id": "memory",
      "name": "Redis Agent Chat Memory",
      "type": "@redis/n8n-nodes-agent-memory.redisAgentChatMemory",
      "typeVersion": 1,
      "position": [
        640,
        440
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 3
            }
          ]
        }
      },
      "id": "every-night",
      "name": "Every night at 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -240,
        720
      ]
    },
    {
      "parameters": {
        "resource": "session",
        "operation": "getAll",
        "returnAll": true,
        "filters": {}
      },
      "id": "list-all-sessions",
      "name": "List all sessions",
      "type": "@redis/n8n-nodes-agent-memory.redisAgentMemory",
      "typeVersion": 1,
      "position": [
        0,
        720
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "idle",
              "leftValue": "={{ $json.updatedAt ?? $json.createdAt }}",
              "rightValue": "={{ $now.minus({ days: 30 }).toISO() }}",
              "operator": {
                "type": "dateTime",
                "operation": "before"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "idle-sessions",
      "name": "Idle for 30 days",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        240,
        720
      ]
    },
    {
      "parameters": {
        "resource": "session",
        "operation": "delete",
        "sessionId": "={{ $json.sessionId }}"
      },
      "id": "delete-idle-session",
      "name": "Delete idle session",
      "type": "@redis/n8n-nodes-agent-memory.redisAgentMemory",
      "typeVersion": 1,
      "position": [
        480,
        720
      ]
    }
