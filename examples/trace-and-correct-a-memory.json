          "conditions": [
            {
              "id": "has-session-source",
              "leftValue": "={{ ($json.sources ?? []).some(s => s.kind === 'SESSION') }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
