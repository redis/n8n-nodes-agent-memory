      "id": "digest-line",
      "name": "Digest line",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1680,
        400
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "collect-lines",
      "name": "Collect all lines",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1920,
        400
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "digest",
              "name": "digest",
              "value": "=# What the agent learned this week\n\n{{ $json.data.map(r => '**' + r.userId + '**\\n' + r.briefing).join('\\n\\n') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "weekly-digest",
      "name": "Weekly digest",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2160,
        400
      ]
    }
