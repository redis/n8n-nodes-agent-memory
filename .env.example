# Connection to the hosted Agent Memory service, used by the contract and
# end-to-end tests. Copy this file to .env (which git ignores) and fill it in.
# Without these values, those tests are skipped.
AGENT_MEMORY_SERVER_URL=
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_API_KEY=
# Also run the contract test that waits for a real server summary (writes 40
# events and polls for up to 300 seconds).
# AGENT_MEMORY_SUMMARY_TESTS=true
# Also run the contract test that refreshes a summary view and waits for the
# server to compute the summary (up to 300 seconds).
# AGENT_MEMORY_SUMMARY_VIEW_TESTS=true
# Also run the tests that wait for the server to extract long-term memories
# from session events and read their sources (up to 300 seconds).
# AGENT_MEMORY_EXTRACTION_TESTS=true

# Optional end-to-end settings.
# N8N_IMAGE_TAG=2.42.6
# E2E_N8N_PORT=15678
# E2E_LLM_STUB_PORT=18080
# E2E_KEEP_STACK=true
